{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/vdb/*": ["../node_modules/@vendure/dashboard/src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../node_modules/@vendure/dashboard/src/lib/virtual.d.ts"]
}
