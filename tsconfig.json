{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@vendure/dashboard/plugin": ["./node_modules/@vendure/dashboard/dist/plugin/index.d.ts"]
    }
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist", "test/dashboard/vite.config.mts"]
}
