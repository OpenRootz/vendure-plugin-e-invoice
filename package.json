{
  "name": "@openrootz/vendure-plugin-e-invoice",
  "version": "0.1.0",
  "description": "EN 16931 e-invoicing for Vendure: ZUGFeRD/Factur-X (PDF/A-3) and XRechnung (CII/UBL)",
  "license": "MIT",
  "author": "openrootz",
  "homepage": "https://github.com/OpenRootz/vendure-plugin-e-invoice#readme",
  "bugs": {
    "url": "https://github.com/OpenRootz/vendure-plugin-e-invoice/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRootz/vendure-plugin-e-invoice.git"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "e-invoice",
    "e-invoicing",
    "e-rechnung",
    "invoice",
    "zugferd",
    "factur-x",
    "xrechnung",
    "en16931",
    "cii",
    "ubl",
    "pdf-a-3"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dashboard",
    "!dashboard/tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:dashboard",
    "typecheck:dashboard": "tsc -p dashboard/tsconfig.json --pretty false | node test/dashboard/report-ts-errors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "ts-node --transpile-only test/dev-server.ts",
    "dashboard:build": "vite build -c test/dashboard/vite.config.mts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "validate": "bash test/validate/validate.sh",
    "lint": "eslint src dashboard test \"*.mjs\"",
    "lint:fix": "eslint --fix src dashboard test \"*.mjs\"",
    "format": "prettier --write src dashboard test .github \"*.{json,md,mjs,mts,yml,yaml}\"",
    "format:check": "prettier --check src dashboard test .github \"*.{json,md,mjs,mts,yml,yaml}\""
  },
  "peerDependencies": {
    "@vendure/core": "^3.8.0",
    "@vendure/dashboard": "^3.8.0"
  },
  "peerDependenciesMeta": {
    "@vendure/dashboard": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "graphql-tag": "^2.12.7",
    "pdfjs-dist": "~6.5.438",
    "pdfmake": "~0.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.0.0",
    "@vendure/asset-server-plugin": "3.8.1",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "@vendure/testing": "3.8.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "graphql": "^16.14.2",
    "pg": "^8.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
