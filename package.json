{
  "name": "@openrootz/vendure-plugin-e-invoice",
  "version": "0.0.0",
  "description": "EN 16931 e-invoicing for Vendure: ZUGFeRD/Factur-X (PDF/A-3) and XRechnung (CII/UBL)",
  "license": "MIT",
  "author": "openrootz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRootz/vendure-plugin-e-invoice.git"
  },
  "keywords": [
    "vendure",
    "vendure-plugin",
    "e-invoice",
    "zugferd",
    "factur-x",
    "xrechnung",
    "en16931"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dashboard",
    "!dashboard/tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:dashboard",
    "typecheck:dashboard": "tsc -p dashboard/tsconfig.json --pretty false | node test/dashboard/report-ts-errors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "ts-node --transpile-only test/dev-server.ts",
    "dashboard:build": "vite build -c test/dashboard/vite.config.mts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "validate": "bash test/validate/validate.sh"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@vendure/core": "^3.8.0",
    "@vendure/dashboard": "^3.8.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@vendure/dashboard": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "graphql-tag": "^2.12.7",
    "pdfmake": "~0.3.14"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.0.0",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "@vendure/testing": "3.8.1",
    "graphql": "^16.14.2",
    "pg": "^8.13.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
